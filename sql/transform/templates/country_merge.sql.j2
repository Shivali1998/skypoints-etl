-- {{ iso3 }}: upsert members whose latest record is in this country ...
MERGE INTO CURATED.{{ table }} t
USING (SELECT * FROM CURATED.MEMBER_CURRENT WHERE country_iso3 = '{{ iso3 }}') s ON t.member_id = s.member_id
WHEN MATCHED THEN UPDATE SET
  member_name = s.member_name, enrollment_date = s.enrollment_date, last_flight_date = s.last_flight_date,
  tier_code = s.tier_code, agent_name = s.agent_name, state = s.state, country_iso3 = s.country_iso3,
  dob = s.dob, is_active = s.is_active, age = s.age, stale_member = s.stale_member,
  source_file_date = s.source_file_date, updated_ts = s.updated_ts
WHEN NOT MATCHED THEN INSERT VALUES
  (s.member_id, s.member_name, s.enrollment_date, s.last_flight_date, s.tier_code, s.agent_name, s.state,
   s.country_iso3, s.dob, s.is_active, s.age, s.stale_member, s.source_file_date, s.updated_ts);

-- ... and remove members that moved to another country (MEMBER_CURRENT is the source of truth).
DELETE FROM CURATED.{{ table }} t
WHERE NOT EXISTS (SELECT 1 FROM CURATED.MEMBER_CURRENT m
                  WHERE m.member_id = t.member_id AND m.country_iso3 = '{{ iso3 }}');
